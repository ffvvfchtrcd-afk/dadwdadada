# SUPABASE (obrigatório)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# MERCADO PAGO (obrigatório para pagamentos reais)
# Obtenha em: Mercado Pago > Credenciais > Access Token (Produção)
MERCADO_PAGO_ACCESS_TOKEN=seu-access-token-aqui

# OPEN ROUTER (assistente IA no admin)
# Obtenha em: https://openrouter.ai/keys
# Pode colocar várias chaves separadas por vírgula (fallback automático em 402)
OPEN_ROUTER_API_KEY=sk-or-v1-chave1,sk-or-v1-chave2

# Modelo Open Router (opcional — padrão: openrouter/free)
# openrouter/free escolhe automaticamente modelos free com suporte a tool calling
# OPEN_ROUTER_MODEL=openrouter/free

# API PROXY (apenas para desenvolvimento local)
# Coloque a URL do seu deploy na Vercel para testar as APIs localmente
# Exemplo: VITE_API_PROXY=https://seu-projeto.vercel.app
# VITE_API_PROXY=https://nexmarket.vercel.app
